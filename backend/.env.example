# Copy this file to .env and fill in real values. Never commit .env.

# --- Required: PostgreSQL connection ---
DATABASE_URL=postgresql+psycopg://nextrace:nextrace_dev@localhost:5433/nextrace

# --- Optional: AI analysis (POST /investigations/{event_id}/analysis) ---
# The deterministic investigation (GET /investigations/{event_id}) works
# without any of the variables below. AI analysis is an optional add-on -
# if AI_API_KEY (or the provider-specific fallback) is not set, the
# analysis endpoint returns 503 rather than failing the whole application.

# Which AI provider to use: "anthropic" (default), "openai", or "gemini".
AI_PROVIDER=anthropic

# API key for the selected provider. ANTHROPIC_API_KEY / OPENAI_API_KEY /
# GEMINI_API_KEY also work as provider-specific fallbacks if AI_API_KEY is
# unset (matches each vendor's own SDK convention). The key is read
# server-side only - the Angular app never receives it.
AI_API_KEY=your-anthropic-api-key-here

# Model for the selected provider - must belong to whichever AI_PROVIDER
# is configured above. Examples:
#   anthropic: claude-opus-5 (default if AI_MODEL is unset)
#   openai:    gpt-6-astra (default if AI_MODEL is unset)
#   gemini:    gemini-3.8-flash (default if AI_MODEL is unset)
AI_MODEL=claude-opus-5

# --- Optional: GitHub webhook (POST /webhooks/github) ---
# Secret configured on the GitHub webhook, used to verify the
# X-Hub-Signature-256 header on every delivery. If unset, the webhook
# endpoint returns a controlled 503 rather than accepting unsigned
# deliveries - it never silently disables verification.
GITHUB_WEBHOOK_SECRET=

# --- Required for writes: ingest key (POST /events, POST .../analysis) ---
# Shared key callers send in the X-NexTrace-Ingest-Key header. If unset,
# both endpoints return a controlled 503 - they are never left open.
# Generate one with e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
NEXTRACE_INGEST_KEY=

# --- Optional: runtime telemetry (off unless explicitly enabled) ---
# Records this backend's own task-start (deployment) and error_spike events.
# Only produces events on ECS (needs the ECS task metadata endpoint).
# NEXTRACE_RUNTIME_TELEMETRY_ENABLED=true
# NEXTRACE_RUNTIME_SERVICE=nextrace-backend
# NEXTRACE_RUNTIME_ENVIRONMENT=production
# NEXTRACE_ERROR_SPIKE_THRESHOLD=5
# NEXTRACE_ERROR_SPIKE_WINDOW_SECONDS=60
# Local validation only (ignored on ECS, where the real task identity is
# used): attribute events to this local process instead. Events then use
# source_event_id "local/<instance-id>:..." and metadata identity_source=local.
# Use a non-production environment name, e.g. local-validation.
# NEXTRACE_RUNTIME_LOCAL_IDENTITY=true
# NEXTRACE_RUNTIME_INSTANCE_ID=   # optional stable name; default: local-<uuid> per process
