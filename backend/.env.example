# Copy this file to .env and fill in real values. Never commit .env.

# --- Required: PostgreSQL connection ---
DATABASE_URL=postgresql+psycopg://nextrace:nextrace_dev@localhost:5433/nextrace

# --- Optional: AI analysis (POST /investigations/{event_id}/analysis) ---
# The deterministic investigation (GET /investigations/{event_id}) works
# without any of the variables below. AI analysis is an optional add-on -
# if AI_API_KEY (or the provider-specific fallback) is not set, the
# analysis endpoint returns 503 rather than failing the whole application.

# Which AI provider to use: "anthropic" (default), "openai", or "gemini".
AI_PROVIDER=anthropic

# API key for the selected provider. ANTHROPIC_API_KEY / OPENAI_API_KEY /
# GEMINI_API_KEY also work as provider-specific fallbacks if AI_API_KEY is
# unset (matches each vendor's own SDK convention). The key is read
# server-side only - the Angular app never receives it.
AI_API_KEY=your-anthropic-api-key-here

# Model for the selected provider - must belong to whichever AI_PROVIDER
# is configured above. Examples:
#   anthropic: claude-opus-5 (default if AI_MODEL is unset)
#   openai:    gpt-6-astra (default if AI_MODEL is unset)
#   gemini:    gemini-3.8-flash (default if AI_MODEL is unset)
AI_MODEL=claude-opus-5
