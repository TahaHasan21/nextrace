# Copy to .env (repo root) before running `docker compose up --build`.
# docker-compose.yml reads this file automatically for variable
# substitution. Never commit a real .env.
#
# All variables below have safe development defaults baked into
# docker-compose.yml (via ${VAR:-default}) - this file only exists so you
# can override them, e.g. to enable AI analysis or use different local
# PostgreSQL credentials. `docker compose up --build` works with NO .env
# file present at all.

# --- PostgreSQL (development defaults shown; change only if you want
# different local credentials - do not put real production credentials
# here) ---
POSTGRES_DB=nextrace
POSTGRES_USER=nextrace
POSTGRES_PASSWORD=nextrace_dev

# --- AI analysis (optional) ---
# AI analysis is entirely optional - leave AI_API_KEY blank and the stack
# still starts, the frontend loads, and investigations work; the "Analyze
# with AI" button will return a controlled "not configured" error.
#
# AI_PROVIDER selects which provider handles analysis: "anthropic"
# (default), "openai", or "gemini". AI_API_KEY is read by whichever
# provider is selected (ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY
# also work as provider-specific fallbacks). AI_MODEL is provider-specific
# - pick a model that belongs to the selected provider.
#
# Example for Anthropic (default):
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5
#
# Example for OpenAI - uncomment and fill in AI_API_KEY instead:
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-6-astra
#
# Example for Gemini - uncomment and fill in AI_API_KEY instead:
# AI_PROVIDER=gemini
# AI_API_KEY=
# AI_MODEL=gemini-3.8-flash

# --- GitHub webhook (optional) ---
# Secret configured on the GitHub webhook (repo Settings > Webhooks) used
# to verify the X-Hub-Signature-256 header on every delivery to
# POST /webhooks/github. Leave blank and the stack still starts - the
# webhook endpoint returns a controlled 503 rather than accepting
# unsigned deliveries.
GITHUB_WEBHOOK_SECRET=
